{
  "expo": {
    "name": "Edify",
    "slug": "tech-challenge-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/public/Logo.png",
    "scheme": "techchallengemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/public/Logo.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.davidpessoasteam.techchallengemobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/public/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "88954228-996c-4832-a4b1-07eafb795bbf"
      }
    }
  }
}
