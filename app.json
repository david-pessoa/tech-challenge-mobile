{
  "expo": {
    "name": "Edify",
    "slug": "tech-challenge-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/public/Logo.png",
    "scheme": "techchallengemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/public/Logo.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/public/Logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
